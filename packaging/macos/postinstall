#!/bin/bash
# Runs as root after the .pkg is installed: make sure mpv (the audio engine) exists.
# Never fails the installation: without mpv the player explains what to do.
DEPS="/usr/local/share/vk-music-tui/install-deps.sh"
APP="/Applications/VK Music TUI.app"

if [ -x "$DEPS" ]; then
  VKTUI_DEPS_LOG=/tmp/vk-music-tui-deps.log /bin/bash "$DEPS" || true
fi

# refresh Launchpad / Finder so the new icon shows up right away
touch "$APP" 2>/dev/null
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$APP" >/dev/null 2>&1 || true
exit 0
